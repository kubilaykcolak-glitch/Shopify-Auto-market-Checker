{
    "name": "pokeprice-sync",
    "version": "1.0.0",
    "private": true,
    "scripts": {
        "dev": "shopify app dev --use-localhost --localhost-port 3001",
        "dev:vite": "remix vite:dev",
        "build": "remix vite:build",
        "lint": "eslint --cache --cache-location ./node_modules/.cache/eslint .",
        "setup": "prisma generate && prisma migrate deploy",
        "start": "remix-serve ./build/server/index.js",
        "docker-start": "npm run setup && npm run start",
        "prisma:migrate": "prisma migrate dev",
        "prisma:generate": "prisma generate",
        "prisma:studio": "prisma studio"
    },
    "type": "module",
    "engines": {
        "node": "^18.20 || ^20.10 || >=21.0.0"
    },
    "dependencies": {
        "@prisma/client": "^5.9.1",
        "@remix-run/node": "^2.8.0",
        "@remix-run/react": "^2.8.0",
        "@remix-run/serve": "^2.8.0",
        "@shopify/app-bridge-react": "^4.1.4",
        "@shopify/polaris": "^12.9.0",
        "@shopify/shopify-app-remix": "^3.1.0",
        "@shopify/shopify-app-session-storage-prisma": "^5.0.3",
        "isbot": "^4.4.0",
        "node-cron": "^3.0.3",
        "react": "^18.2.0",
        "react-dom": "^18.2.0",
        "resend": "^3.2.0"
    },
    "devDependencies": {
        "@remix-run/dev": "^2.8.0",
        "@types/node": "^20.11.5",
        "@types/node-cron": "^3.0.11",
        "@types/react": "^18.2.55",
        "@types/react-dom": "^18.2.19",
        "eslint": "^8.56.0",
        "prisma": "^5.9.1",
        "typescript": "^5.3.3",
        "vite": "^5.1.0",
        "vite-tsconfig-paths": "^4.3.1"
    }
}
