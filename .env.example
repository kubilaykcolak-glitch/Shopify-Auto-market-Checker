# ─────────────────────────────────────────────────────────────
# PriceSync for Shopify — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────

# ── Shopify App Credentials ─────────────────────────────────────
# Get these from: https://partners.shopify.com → Apps → Your App → Configuration
SHOPIFY_API_KEY=your_shopify_api_key_here
SHOPIFY_API_SECRET=your_shopify_api_secret_here

# The public URL where your app is hosted (no trailing slash)
# In development, use the tunnel URL shown by `npm run dev`
SHOPIFY_APP_URL=https://your-app-url.fly.dev

# ── Database ────────────────────────────────────────────────────
# SQLite for local dev:
DATABASE_URL="file:./dev.db"
# PostgreSQL for production (uncomment and fill in):
# DATABASE_URL="postgresql://user:password@host:5432/pokeprice?sslmode=require"

# ── eBay Browse API ─────────────────────────────────────────────
# Register at: https://developer.ebay.com/
# Go to: My Account → Application Keys → Get a Free Key Set → Production
# EBAY_CLIENT_ID  = "App ID (Client ID)"    on that page
# EBAY_CLIENT_SECRET = "Cert ID (Client Secret)" on that page
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=

# ── TCGPlayer API ────────────────────────────────────────────────
# Apply at: https://developer.tcgplayer.com/ (takes 1-2 weeks for approval)
TCGPLAYER_PUBLIC_KEY=
TCGPLAYER_PRIVATE_KEY=

# ── PriceCharting API ────────────────────────────────────────────
# Sign up at: https://www.pricecharting.com/api-documentation
PRICECHARTING_API_KEY=

# ── Email Alerts (Resend) ─────────────────────────────────────────
# Sign up at: https://resend.com → API Keys → Create API Key
RESEND_API_KEY=
# The "from" address for alert emails. Must be a verified domain in Resend.
# For testing you can use: onboarding@resend.dev (Resend's sandbox address)
RESEND_FROM_EMAIL=alerts@yourdomain.com

# ── Currency ─────────────────────────────────────────────────────
# PriceCharting returns USD prices — this converts to GBP for your store.
# Update periodically or integrate a live forex API later.
USD_TO_GBP_RATE=0.79

# ── App Scopes (must match shopify.app.toml) ─────────────────────
SCOPES=read_products,write_products,read_inventory,write_inventory

# ── Optional: Custom Domain ───────────────────────────────────────
# SHOP_CUSTOM_DOMAIN=
